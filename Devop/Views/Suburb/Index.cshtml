@model IEnumerable<Devop.Models.Content.Suburb>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="AddOrEdit" class="btn btn btn-primary btn-rounded float-right">Add Suburb+</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SuburbName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SuburbName)
            </td>
            <td>
                <a asp-action="AddOrEdit" asp-route-id="@item.SuburbId">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.SuburbId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
